// #include <behaviors/rgbled_widget.dtsi>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;

    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        CapsLock {
            bindings = <&kp LS(CAPSLOCK)>;
            key-positions = <10 21>;
        };

        IME_ON {
            bindings = <&kp INT_HENKAN>;
            key-positions = <30 31>;
        };

        IME_OFF {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <24 25>;
        };

        PrintScreen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <6 7>;
        };

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <18 19>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <19 20>;
        };

        middle_click {
            bindings = <&mkp MB3>;
            key-positions = <18 19 20>;
        };

        mouse_click_5 {
            bindings = <&mkp MB5>;
            key-positions = <17 18>;
        };

        mouse_click_4 {
            bindings = <&mkp MB4>;
            key-positions = <29 30>;
        };

        PM_first_make {
            bindings = <&PM_first_make>;
            key-positions = <9 30 14>;
        };

        View_Depth_1000 {
            bindings = <&View_Depth_1000>;
            key-positions = <1 12 25>;
        };

        PDF_DOCU {
            bindings = <&PDF_DOCU>;
            key-positions = <9 13 12 8>;
        };

        DOCU_SerialNum {
            bindings = <&DOCU_SerialNum>;
            key-positions = <12 24 8 6>;
        };

        ISO_A {
            bindings = <&ISO_A>;
            key-positions = <7 8 10 11>;
        };

        ISO_B {
            bindings = <&ISO_B>;
            key-positions = <7 8 11 26>;
        };

        ISO_C {
            bindings = <&ISO_C>;
            key-positions = <7 8 11 24>;
        };

        ISO_D {
            bindings = <&ISO_D>;
            key-positions = <7 8 11 12>;
        };

        ISO_P {
            bindings = <&ISO_P>;
            key-positions = <7 8 9 11>;
        };

        ISO_S {
            bindings = <&ISO_S>;
            key-positions = <7 8 11 23>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        View_Depth_1000: View_Depth_1000 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp NUMBER_1>,
                <&macro_wait_time 100>,
                <&kp ENTER &kp N0 &kp N0 &kp N0 &kp HOME>;

            label = "VIEW_DEPTH_1000";
        };

        PDF_DOCU: PDF_DOCU {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB &kp TAB &kp TAB &kp DOWN_ARROW &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp SPACE &kp LS(TAB) &kp LS(TAB) &kp NUMBER_1 &kp NUMBER_3 &kp TAB &kp NUMBER_1 &kp NUMBER_3 &kp ENTER &kp TAB &kp TAB &kp ENTER>;
            label = "PDF_DOCU";
        };

        DOCU_SerialNum: DOCU_SerialNum {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LA(D)>,
                <&macro_wait_time 700>,
                <&kp S &kp LC(TAB)>,
                <&macro_wait_time 30>,
                <&kp LC(TAB) &kp LC(TAB) &kp LC(TAB) &kp LS(N) &kp O &kp DOT &kp POUND &kp TAB &kp TAB &kp UP_ARROW &kp TAB &kp N1 &kp N7 &kp TAB &kp DOWN_ARROW &kp LS(TAB) &kp N2 &kp N6 &kp ENTER &kp ENTER &kp LC(S)>;

            label = "DOCU_SERIALNUM";
        };

        ISO_A: ISO_A {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB &kp TAB &kp TAB &kp TAB &kp SPACE &kp UP_ARROW &kp UP_ARROW &kp UP_ARROW &kp ENTER &kp LS(A) &kp UNDER &kp END &kp BACKSPACE>;
            label = "ISO_A";
        };

        ISO_B: ISO_B {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB &kp TAB &kp TAB &kp TAB &kp SPACE &kp UP_ARROW &kp UP_ARROW &kp UP_ARROW &kp ENTER &kp LS(B) &kp UNDER &kp END &kp BACKSPACE>;
            label = "ISO_B";
        };

        ISO_C: ISO_C {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB &kp TAB &kp TAB &kp TAB &kp SPACE &kp UP_ARROW &kp UP_ARROW &kp UP_ARROW &kp ENTER &kp LS(C) &kp UNDER &kp END &kp BACKSPACE>;
            label = "ISO_C";
        };

        ISO_D: ISO_D {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB &kp TAB &kp TAB &kp TAB &kp SPACE &kp UP_ARROW &kp UP_ARROW &kp UP_ARROW &kp ENTER &kp LS(D) &kp UNDER &kp END &kp BACKSPACE>;
            label = "ISO_D";
        };

        ISO_P: ISO_P {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB &kp TAB &kp TAB &kp TAB &kp SPACE &kp UP_ARROW &kp UP_ARROW &kp UP_ARROW &kp ENTER &kp LS(P) &kp UNDER &kp END &kp BACKSPACE>;
            label = "ISO_P";
        };

        ISO_S: ISO_S {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB &kp TAB &kp TAB &kp TAB &kp SPACE &kp UP_ARROW &kp UP_ARROW &kp UP_ARROW &kp ENTER &kp LS(S) &kp UNDER &kp END &kp BACKSPACE>;
            label = "ISO_S";
        };

        PM_first_make: PM_first_make {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp SPACE &kp TAB &kp TAB &kp TAB &kp TAB>,
                <&macro_wait_time 2000>,
                <&kp ENTER &kp TAB>,
                <&macro_wait_time 30>,
                <&kp TAB &kp DOWN_ARROW &kp SPACE &kp TAB &kp TAB &kp TAB>,
                <&macro_wait_time 2000>,
                <&kp ENTER &kp TAB>,
                <&macro_wait_time 30>,
                <&kp TAB &kp SPACE>,
                <&macro_wait_time 2000>,
                <&kp ENTER &kp LS(TAB)>,
                <&macro_wait_time 30>,
                <&kp SPACE &kp TAB &kp TAB &kp TAB &kp TAB &kp SPACE &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp SPACE &kp ENTER>;

            label = "PM_FIRST_MAKE";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W      &kp E         &kp R                      &kp T                                                 &kp Y      &kp U              &kp I            &kp O    &kp P
&lt 2 A         &kp S      &kp D         &kp F                      &kp G        &kp LS(LG(S))      &kp K_CONTEXT_MENU    &kp H      &kp J              &kp K            &kp L    &lt 5 SEMICOLON
&kp Z           &kp X      &mt LCTRL C   &mt LEFT_SHIFT V           &kp B        &kp DELETE         &lt 6 MINUS           &kp N      &mt RIGHT_SHIFT M  &mt RCTRL COMMA  &kp DOT  &lt 2 SLASH
&kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_GUI  &mt LEFT_ALT LA(NUMBER_3)  &lt 3 SPACE  &lt 1 TAB          &mt RIGHT_ALT ESCAPE  &kp ENTER                                               &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        SYMBOLS {
            bindings = <
&kp AMPERSAND  &trans       &kp HASH  &trans     &trans                         &trans  &trans                &kp EXCLAMATION        &trans            &trans
&kp AT_SIGN    &kp DOLLAR   &trans    &trans     &trans  &trans      &trans     &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans         &kp PERCENT  &trans    &kp CARET  &trans  &trans      &kp TILDE  &trans  &trans                &kp SQT                &kp GRAVE         &kp BACKSLASH
&trans         &trans       &trans    &trans     &trans  &trans      &trans     &trans                                                                 &trans
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        NUM {
            bindings = <
&kp F12  &kp F7  &kp F8  &kp F9  &trans                                &kp RS(R)     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SLASH
&kp F11  &kp F4  &kp F5  &kp F6  &kp LEFT_ALT  &trans      &kp EQUAL   &kp RC(A)     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ASTERISK
&kp F10  &kp F1  &kp F2  &kp F3  &trans        &trans      &kp PERIOD  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS
&trans   &trans  &trans  &trans  &trans        &trans      &trans      &trans                                                  &kp PLUS
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        ARROW {
            bindings = <
&kp HOME          &trans          &kp UP_ARROW    &trans           &kp PAGE_UP                                     &kp LG(LS(UP_ARROW))    &trans                  &kp LG(UP_ARROW)    &trans                   &trans
&kp END           &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN     &trans                &trans  &kp LG(LS(LEFT_ARROW))  &kp LG(LEFT_ARROW)      &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)      &kp LG(LS(RIGHT_ARROW))
&kp LS(NUMBER_1)  &kp LS(SQT)     &trans          &kp INSERT       &kp LA(NUMBER_1)  &kp LA(NUMBER_2)      &trans  &trans                  &kp LG(LC(LEFT_ARROW))  &kp LG(TAB)         &kp LG(LC(RIGHT_ARROW))  &kp LG(LS(DOWN_ARROW))
&trans            &trans          &trans          &trans           &trans            &trans                &trans  &trans                                                                                       &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_DOWN) LC(PAGE_UP)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        Bluetooth {
            bindings = <
&trans        &trans        &trans        &trans        &trans                                    &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL      &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR          &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &bootloader         &trans  &trans                          &trans
            >;
        };
    };
};
